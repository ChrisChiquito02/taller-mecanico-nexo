{
  "name": "examenerik-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:integrated": "node scripts/build.mjs --integrated",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3"
  }
}
