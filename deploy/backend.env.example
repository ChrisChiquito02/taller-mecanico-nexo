# Ejemplo público. Cargar valores REALES solo en el gestor de secretos de Render Free.
DB_URL=jdbc:mysql://db.tu-identificador.is-a.dev:3306/identity?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USERNAME=identity_app
DB_PASSWORD=REEMPLAZAR
JWT_SIGNING_KEY=REEMPLAZAR_BASE64_32_BYTES_O_MAS
APP_ALLOWED_ORIGINS=https://app.tu-identificador.is-a.dev
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Strict
APP_RECOVERY_MODE=smtp
APP_RECOVERY_BASE_URL=https://app.tu-identificador.is-a.dev/reset-password.html
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=REEMPLAZAR
SMTP_PASSWORD=REEMPLAZAR
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=REEMPLAZAR_REMITENTE_VERIFICADO
APP_BOOTSTRAP_ENABLED=false
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CA_CERT_BASE64=BASE64_DEL_CERTIFICADO_PUBLICO_CA_PEM

# NEXO: la IA pública requiere un servicio de inferencia privado preparado.
NEXO_PROVIDER=disabled
NEXO_MODEL=qwen2.5-coder:7b
NEXO_RETENTION_DAYS=7
NEXO_MAX_TOKENS=700
