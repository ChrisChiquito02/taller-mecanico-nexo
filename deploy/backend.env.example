# Ejemplo público. Cargar valores REALES solo en el gestor de secretos de Render Free.
DB_URL=jdbc:mysql://gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/identity?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
DB_USERNAME=3UKryH6ponsVZQa.identity_app
DB_PASSWORD=REEMPLAZAR
JWT_SIGNING_KEY=REEMPLAZAR_BASE64_32_BYTES_O_MAS
APP_ALLOWED_ORIGINS=https://app.tu-identificador.is-a.dev
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=None
APP_RECOVERY_MODE=disabled
APP_RECOVERY_BASE_URL=https://app.tu-identificador.is-a.dev/reset-password.html
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=true
SMTP_FROM=noreply@example.invalid
APP_BOOTSTRAP_ENABLED=false
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
# TiDB Cloud usa una CA pública confiable por Java; no hace falta DB_CA_CERT_BASE64.

# NEXO: la IA pública requiere un servicio de inferencia privado preparado.
NEXO_PROVIDER=disabled
NEXO_MODEL=qwen2.5-coder:7b
NEXO_RETENTION_DAYS=7
NEXO_MAX_TOKENS=700
