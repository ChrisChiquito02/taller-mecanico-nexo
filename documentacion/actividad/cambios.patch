+  });
+  let headers = '';
+  const frontPort = await listen((req,res)=>{
+    const file = {'/':'index.html','/index.html':'index.html','/reset-password.html':'reset-password.html','/app.js':'app.js','/styles.css':'styles.css'}[req.url.split('?')[0]];
