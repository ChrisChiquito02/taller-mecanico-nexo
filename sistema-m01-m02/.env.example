# Plantilla para ejecución directa. No se carga automáticamente: exportar variables o usar Compose.
DB_URL=jdbc:mysql://localhost:3306/identity_local?serverTimezone=UTC
DB_USERNAME=identity_app
DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
JWT_SIGNING_KEY=REPLACE_WITH_BASE64_RANDOM_32_BYTES_OR_MORE
APP_ALLOWED_ORIGINS=https://app.example.com
APP_COOKIE_SECURE=true
APP_RECOVERY_MODE=smtp
APP_RECOVERY_BASE_URL=https://app.example.com/reset-password.html
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_ACCOUNT
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=noreply@example.com
SMTP_AUTH=true
SMTP_STARTTLS=true
APP_BOOTSTRAP_ENABLED=false
# Solo para la primera instalación vacía; eliminar después del alta inicial:
# APP_BOOTSTRAP_EMAIL=admin@gmail.com
# APP_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
